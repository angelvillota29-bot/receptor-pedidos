# SPA de React: cualquier ruta que no sea un archivo real (o /api, /data)
# cae a index.html, y React se encarga de mostrar la página.
FallbackResource /index.html

# Headers de seguridad básicos -- no rompen nada (no es un CSP estricto, que
# podría bloquear el botón de Google sin darse cuenta).
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains"
</IfModule>

# Archivos de despliegue/configuración que nunca deben descargarse por la web
# (antes /entrypoint.sh se podía bajar tal cual desde cualquier navegador).
<FilesMatch "\.(sh|ini|md|dockerfile)$|^Dockerfile$">
    Require all denied
</FilesMatch>
