# SPA de React: cualquier ruta que no sea un archivo real (o /api, /data)
# cae a index.html, y React se encarga de mostrar la página.
FallbackResource /index.html

# Headers de seguridad básicos -- no rompen nada (no es un CSP estricto, que
# podría bloquear el botón de Google sin darse cuenta).
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains"

    # Content-Security-Policy: limita de dónde puede cargar scripts, estilos,
    # imágenes y conexiones la página (defensa extra contra XSS). Permitidos:
    # Google Sign-In (accounts.google.com) y Google Fonts. Sin scripts inline.
    Header set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://accounts.google.com; frame-src https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# Archivos de despliegue/configuración que nunca deben descargarse por la web
# (antes /entrypoint.sh se podía bajar tal cual desde cualquier navegador).
<FilesMatch "\.(sh|ini|md|dockerfile)$|^Dockerfile$">
    Require all denied
</FilesMatch>
